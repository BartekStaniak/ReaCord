#include "resource.h"
#include <windows.h>

IDD_REACORD_SETTINGS DIALOGEX 0, 0, 280, 248
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ReaCord - Discord Rich Presence Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Enable Discord Rich Presence",IDC_ENABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,12,180,10
    CONTROL         "Incognito Mode (Hide all project & track details)",IDC_INCOGNITO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,26,220,10
    
    GROUPBOX        "Privacy & Metadata Opt-Ins",IDC_STATIC,10,44,260,122
    LTEXT           "Project Name:",IDC_STATIC,18,58,65,8
    COMBOBOX        IDC_COMBO_PROJ_NAME,90,56,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Session Time:",IDC_STATIC,18,76,65,8
    COMBOBOX        IDC_COMBO_SESSION_TIME,90,74,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Play / Record State:",IDC_STATIC,18,94,70,8
    COMBOBOX        IDC_COMBO_PLAY_STATE,90,92,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Profile Card Logo:",IDC_STATIC,18,112,70,8
    COMBOBOX        IDC_COMBO_ICON_STYLE,90,110,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "Show Track Count",IDC_CHECK_TRACK_COUNT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,134,120,10
    
    GROUPBOX        "Discord Application Client ID",IDC_STATIC,10,172,260,44
    EDITTEXT        IDC_EDIT_CLIENT_ID,18,185,170,14,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Default ID",IDC_BTN_RESET_DEFAULT,194,185,68,14
    LTEXT           "Default: Official REAPER App (1462972195658534965)",IDC_STATIC,18,202,244,8
    
    PUSHBUTTON      "Help / Guide",IDC_BTN_HELP,10,224,52,14
    LTEXT           "Status: Disconnected",IDC_STATUS_TEXT,66,226,100,12
    DEFPUSHBUTTON   "OK",IDOK,170,224,32,14
    PUSHBUTTON      "Cancel",IDCANCEL,206,224,34,14
    PUSHBUTTON      "Apply",IDC_APPLY,244,224,28,14
END
