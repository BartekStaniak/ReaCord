#include "resource.h"
#include <windows.h>

IDD_REACORD_SETTINGS DIALOGEX 0, 0, 280, 296
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ReaCord - Discord Rich Presence Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Enable Discord Rich Presence",IDC_ENABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,10,180,10
    CONTROL         "Incognito Mode (Hide all project && track details)",IDC_INCOGNITO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,24,220,10
    
    GROUPBOX        "Privacy && Metadata Opt-Ins",IDC_STATIC,10,38,260,104
    LTEXT           "Project Name:",IDC_STATIC,18,50,65,8
    COMBOBOX        IDC_COMBO_PROJ_NAME,90,48,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Session Time:",IDC_STATIC,18,68,65,8
    COMBOBOX        IDC_COMBO_SESSION_TIME,90,66,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Play / Record State:",IDC_STATIC,18,86,70,8
    COMBOBOX        IDC_COMBO_PLAY_STATE,90,84,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Profile Card Logo:",IDC_STATIC,18,104,70,8
    COMBOBOX        IDC_COMBO_ICON_STYLE,90,102,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "Show Track Count",IDC_CHECK_TRACK_COUNT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,124,120,10

    CONTROL         "Show Advanced Settings (Client ID && Custom Timers)",IDC_CHECK_SHOW_ADVANCED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,148,250,10

    GROUPBOX        "Advanced Settings",IDC_GROUP_ADVANCED,10,162,260,78
    LTEXT           "Discord Client ID:",IDC_STATIC_CLIENT_ID,18,175,65,8
    EDITTEXT        IDC_EDIT_CLIENT_ID,86,173,118,13,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Default ID",IDC_BTN_RESET_DEFAULT,208,173,54,13
    LTEXT           "Default: Official REAPER App (1462972195658534965)",IDC_STATIC_DEFAULT_ID,86,189,176,8

    LTEXT           "ExtState Sec / Key:",IDC_STATIC_EXTSTATE,18,206,68,8
    EDITTEXT        IDC_EDIT_EXTSTATE_SECTION,86,204,80,13,ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDIT_EXTSTATE_KEY,170,204,92,13,ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "Append tracked active time to presence playback text",IDC_CHECK_EXTSTATE_TEXT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,222,240,10

    LTEXT           "Status: Disconnected",IDC_STATUS_TEXT,14,248,252,9,SS_LEFTNOWORDWRAP
    PUSHBUTTON      "Help / Guide",IDC_BTN_HELP,10,262,52,14
    DEFPUSHBUTTON   "OK",IDOK,166,262,32,14
    PUSHBUTTON      "Cancel",IDCANCEL,202,262,34,14
    PUSHBUTTON      "Apply",IDC_APPLY,240,262,30,14
END
