#include "resource.h"
#include <windows.h>

IDD_REACORD_SETTINGS DIALOGEX 0, 0, 280, 240
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ReaCord - Discord Rich Presence Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Enable Discord Rich Presence",IDC_ENABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,10,180,10
    CONTROL         "Incognito Mode (Hide all project & track details)",IDC_INCOGNITO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,24,220,10
    
    GROUPBOX        "Privacy & Metadata Opt-Ins",IDC_STATIC,10,38,260,120
    LTEXT           "Project Name:",IDC_STATIC,18,50,65,8
    COMBOBOX        IDC_COMBO_PROJ_NAME,90,48,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Session Time:",IDC_STATIC,18,68,65,8
    COMBOBOX        IDC_COMBO_SESSION_TIME,90,66,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Play / Record State:",IDC_STATIC,18,86,70,8
    COMBOBOX        IDC_COMBO_PLAY_STATE,90,84,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Profile Card Logo:",IDC_STATIC,18,104,70,8
    COMBOBOX        IDC_COMBO_ICON_STYLE,90,102,165,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "Show Track Count",IDC_CHECK_TRACK_COUNT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,122,95,10
    CONTROL         "Append active time to status",IDC_CHECK_EXTSTATE_TEXT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,118,122,140,10
    
    LTEXT           "ExtState Sec / Key:",IDC_STATIC,18,138,72,8
    EDITTEXT        IDC_EDIT_EXTSTATE_SECTION,90,136,80,12,ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDIT_EXTSTATE_KEY,175,136,80,12,ES_AUTOHSCROLL | WS_TABSTOP

    GROUPBOX        "Discord Application Client ID",IDC_STATIC,10,164,260,42
    EDITTEXT        IDC_EDIT_CLIENT_ID,18,176,170,14,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Default ID",IDC_BTN_RESET_DEFAULT,194,176,68,14
    LTEXT           "Default: Official REAPER App (1462972195658534965)",IDC_STATIC,18,193,244,8
    
    PUSHBUTTON      "Help / Guide",IDC_BTN_HELP,10,214,52,14
    LTEXT           "Status: Disconnected",IDC_STATUS_TEXT,66,216,100,12
    DEFPUSHBUTTON   "OK",IDOK,170,214,32,14
    PUSHBUTTON      "Cancel",IDCANCEL,206,214,34,14
    PUSHBUTTON      "Apply",IDC_APPLY,244,214,28,14
END
